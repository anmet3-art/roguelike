{
    // --- Терминал: cmd вместо PowerShell, чтобы работали "<" и ">" ---
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    // g++, gdb и cmake из MSYS2 UCRT64 доступны в терминале VS Code
    "terminal.integrated.env.windows": {
        "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
    },

    // --- Файлы ---
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    // --- Редактор ---
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],

    // --- C++ / IntelliSense ---
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.formatting": "default",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 100 }",
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },

    // --- CMake ---
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "cmake.saveBeforeBuild": true,
    "cmake.options.statusBarVisibility": "visible",
    "C_Cpp.errorSquiggles": "disabled"
}
